{
  "name": "phoenix-backend",
  "version": "1.0.0",
  "description": "Phoenix portfolio backend API",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "prisma db push --skip-generate && node src/seed.js && node src/index.js",
